# Public URL of the deployed site. Used for canonical URLs, Open Graph,
# the sitemap and structured data. On Vercel it falls back to the project's
# production domain; elsewhere it defaults to https://construkt.example.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Where project inquiries are delivered (CRM, email service, automation
# webhook…). The endpoint receives a JSON POST with an Idempotency-Key header.
# Leave unset and the contact form will say plainly that nothing was sent.
INQUIRY_WEBHOOK_URL=
